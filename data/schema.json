{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "games",
    "watchlist",
    "mappings",
    "metadata"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "games": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/game"
      }
    },
    "mappings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "gameId",
          "upstreamId",
          "twConceptId",
          "platforms",
          "method",
          "source",
          "trophyGroups"
        ],
        "properties": {
          "gameId": {
            "type": "string"
          },
          "upstreamId": {
            "type": "string"
          },
          "twConceptId": {
            "type": "string"
          },
          "platforms": {
            "$ref": "#/definitions/platforms"
          },
          "method": {
            "enum": [
              "concept-id+platform",
              "product-id+platform",
              "manual-evidence"
            ]
          },
          "source": {
            "$ref": "#/definitions/source"
          },
          "trophyGroups": {
            "type": "array"
          }
        }
      }
    },
    "watchlist": {
      "type": "object",
      "required": [
        "entries",
        "pending",
        "excluded"
      ],
      "properties": {
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "gameId",
              "cycleId",
              "platforms",
              "snapshotId",
              "upstreamRank",
              "addedAt",
              "prediction",
              "officialDeparture",
              "tier"
            ],
            "properties": {
              "gameId": {
                "type": "string"
              },
              "cycleId": {
                "type": "string",
                "pattern": "^cycle-"
              },
              "platforms": {
                "$ref": "#/definitions/platforms"
              },
              "snapshotId": {
                "type": "string"
              },
              "upstreamRank": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1
              },
              "addedAt": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "prediction": {
                "type": "object"
              },
              "officialDeparture": {
                "type": [
                  "object",
                  "null"
                ]
              },
              "suspended": {
                "type": "boolean"
              },
              "tier": {
                "enum": [
                  "Extra",
                  "Deluxe"
                ]
              }
            }
          }
        },
        "pending": {
          "type": "array"
        },
        "excluded": {
          "type": "array"
        }
      }
    },
    "metadata": {
      "type": "object",
      "required": [
        "snapshotId",
        "lastSuccessAt",
        "asOf",
        "complete",
        "validSnapshot",
        "sources",
        "counts",
        "removalEvents"
      ],
      "properties": {
        "snapshotId": {
          "type": "string"
        },
        "lastSuccessAt": {
          "type": "string"
        },
        "asOf": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "complete": {
          "type": "boolean"
        },
        "validSnapshot": {
          "type": "boolean"
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/source"
          }
        },
        "counts": {
          "type": "object"
        },
        "removalEvents": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "gameId",
              "cycleId",
              "snapshotId",
              "confirmed",
              "reason"
            ],
            "properties": {
              "gameId": {
                "type": "string"
              },
              "cycleId": {
                "type": "string"
              },
              "snapshotId": {
                "type": "string"
              },
              "confirmed": {
                "type": "boolean"
              },
              "reason": {
                "enum": [
                  "upstream-absent",
                  "official-departure"
                ]
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "source": {
      "type": "object",
      "required": [
        "url",
        "checkedAt"
      ],
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^https://"
        },
        "checkedAt": {
          "type": "string"
        },
        "status": {
          "type": "string"
        }
      }
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "PS4",
          "PS5"
        ]
      }
    },
    "hours": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "min",
            "max",
            "source"
          ],
          "properties": {
            "min": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "max": {
              "type": [
                "number",
                "null"
              ],
              "exclusiveMinimum": 0
            },
            "source": {
              "$ref": "#/definitions/source"
            }
          }
        }
      ]
    },
    "game": {
      "type": "object",
      "required": [
        "gameId",
        "upstreamId",
        "twConceptId",
        "nameZh",
        "nameEn",
        "nameSource",
        "genres",
        "versions",
        "mainHours",
        "platinumHours",
        "platinumDifficulty",
        "rating",
        "evaluation",
        "sources"
      ],
      "properties": {
        "gameId": {
          "type": "string",
          "pattern": "^ss-"
        },
        "upstreamId": {
          "type": "string"
        },
        "twConceptId": {
          "type": "string"
        },
        "nameZh": {
          "type": [
            "string",
            "null"
          ]
        },
        "nameEn": {
          "type": "string"
        },
        "nameSource": {
          "$ref": "#/definitions/source"
        },
        "genres": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "versions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "platform",
              "productId",
              "trophyGroupId",
              "baseTrophies",
              "hasPlatinum",
              "source"
            ],
            "properties": {
              "platform": {
                "enum": [
                  "PS4",
                  "PS5"
                ]
              },
              "productId": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "trophyGroupId": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "hasPlatinum": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "baseTrophies": {
                "type": [
                  "object",
                  "null"
                ],
                "required": [
                  "total",
                  "bronze",
                  "silver",
                  "gold",
                  "platinum",
                  "source"
                ],
                "properties": {
                  "total": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "bronze": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "silver": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "gold": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "platinum": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "source": {
                    "$ref": "#/definitions/source"
                  }
                }
              },
              "source": {
                "$ref": "#/definitions/source"
              }
            }
          }
        },
        "mainHours": {
          "$ref": "#/definitions/hours"
        },
        "platinumHours": {
          "$ref": "#/definitions/hours"
        },
        "platinumDifficulty": {
          "type": [
            "string",
            "null"
          ]
        },
        "rating": {
          "type": [
            "object",
            "null"
          ],
          "required": [
            "score",
            "source"
          ],
          "properties": {
            "score": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "source": {
              "$ref": "#/definitions/source"
            }
          }
        },
        "evaluation": {
          "type": "object",
          "required": [
            "rank",
            "goal",
            "reason",
            "risks",
            "confidence",
            "evaluatedAt",
            "promptVersion",
            "sources"
          ],
          "properties": {
            "rank": {
              "enum": [
                "S",
                "A",
                "B",
                "C",
                "D",
                null
              ]
            },
            "goal": {
              "enum": [
                "主線",
                "白金",
                "全獎盃",
                "休閒",
                "略過",
                null
              ]
            },
            "reason": {
              "type": "string"
            },
            "risks": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "confidence": {
              "enum": [
                "high",
                "medium",
                "low",
                "unknown"
              ]
            },
            "evaluatedAt": {
              "type": [
                "string",
                "null"
              ]
            },
            "promptVersion": {
              "enum": [
                "EVALUATION-v1",
                "EVALUATION-v2"
              ]
            },
            "sources": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/source"
              }
            }
          }
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/source"
          }
        },
        "cover": {
          "type": "object",
          "required": [
            "path",
            "source",
            "alt"
          ],
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^covers/[0-9]+\\.jpg$"
            },
            "source": {
              "$ref": "#/definitions/source"
            },
            "alt": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
